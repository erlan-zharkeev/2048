html(lang="en")
	include includes/head
	body
		audio#move(src='./assets/audio/move.mp3')
		audio#merge(src='./assets/audio/merge.mp3')
		.wrapper
			.IE.hide 
				span your browser not support
			.settings-icon
				i(class="fa fa-question-circle")
			.settings-content.hide
				.how-play
					span how to play?
					p Move tiles by pressing the arrows on your keyboard or by swiping. Tiles will merge if they have the same numbers. Try to get 2048 tile.
				.mail
					a(href="https://www.facebook.com/erlan.zharkeev" target="_blank")
						span send feedback
			.message.lose.hide
				p you lose(
				span next time you will definitely win!
				button#new-game.new-game ok
			.message.win.hide
				p Congratulations!
				span you win!
				span keep going to reach 4096 tile!
				button#continue continue
			.game
				.info 
					.title 
						h1 2048 
					.sound  
						.bg-no_sound 
					.score 
						p score 
						span 0
					.new-game-btn 
						span new game	
				.table
					.table__cell#1-1
					.table__cell#1-2
					.table__cell#1-3
					.table__cell#1-4
					.table__cell#2-1
					.table__cell#2-2
					.table__cell#2-3
					.table__cell#2-4
					.table__cell#3-1
					.table__cell#3-2
					.table__cell#3-3
					.table__cell#3-4
					.table__cell#4-1
					.table__cell#4-2
					.table__cell#4-3
					.table__cell#4-4


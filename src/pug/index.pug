html(lang='en')
  include includes/head
  body
    .wrapper
      include includes/message
      include includes/settings
      main.game
        header.info
          .title
            h1 2048
          .sound
            button#sound-toggle(
              type='button',
              aria-label='Toggle sound',
              aria-pressed='false',
              data-state='off'
            )
              span#sound-icon.bg-no-sound
          .score
            p score
            span#scoreNum 0
          button.new-game-btn(type='button')
            span new game
        .table
          - var rowCell = 0
          while rowCell<4
            - ++rowCell
            - var colCell = 0
            while colCell<4
              - ++colCell
              .table__cell(id=`${rowCell}-${colCell}`)
      .mail
        button(
          type='button',
          aria-label='Share feedback',
          onclick="window.location.href='mailto:zharkeev.post@gmail.com'"
        )
          <svg width="30px" height="30px" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" fill="#ffffff" class="bi bi-envelope-fill">

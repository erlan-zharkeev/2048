{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "semi": ["error", "never"],
    "no-underscore-dangle": "off",
    "class-methods-use-this": "off",
    "radix": ["error", "as-needed"],
    "no-param-reassign": ["error", { "props": false }],
    "no-new": "off",
    "linebreak-style": ["error", "windows"]
  }
}
